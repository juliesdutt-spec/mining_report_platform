# Environment Configuration for Mining Report Platform
# SIH26023 - AI-Powered Geological & Mining Reporting Solution
#
# Copy to .env and fill in. .env is gitignored and untracked - never commit a real key.
#   cp .env.example .env

# Claude API Configuration
# Get your API key from: https://console.anthropic.com/
# Without a key the backend automatically falls back to deterministic mock
# extraction and answers (see ai_extractor.py), so the demo still runs.
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-opus-5

# "true" forces mock AI even when a key is present (useful for offline demos).
# "false" uses the real Claude API - but only if CLAUDE_API_KEY is set.
USE_MOCK_AI=false

# Database (SQLite by default, PostgreSQL for production)
# DATABASE_URL=postgresql://user:pass@localhost/mining_reports

# Backend URL (for Streamlit to connect to FastAPI)
BACKEND_URL=http://localhost:8000
