# Environment Configuration for Mining Report Platform
# SIH26023 - AI-Powered Geological & Mining Reporting Solution
#
# Copy to .env and fill in. .env is gitignored and untracked - never commit a real key.
#   cp .env.example .env
#
# Nothing here is required. With no provider configured the backend serves
# deterministic mock extraction and answers, and every screen still works.
# Confirm which mode you are in at any time with:
#   curl http://localhost:8000/health


# ============================================================================
# WHICH AI PROVIDER TO USE
# ============================================================================
# auto        first provider below that has credentials (the default)
# gemini      Google Gemini      - has a free tier, no card needed
# openrouter  OpenRouter         - has free models, no card needed
# ollama      local Ollama       - free and offline, no key at all
# claude      Anthropic          - paid
# mock        force deterministic answers, ignore every key below
AI_PROVIDER=auto

# Seconds to wait for a model before falling back to a mock answer.
# Local Ollama on CPU is slow; raise this if you see timeouts.
AI_TIMEOUT_SECONDS=90


# ============================================================================
# OPTION 1 - GEMINI (recommended: free tier, no payment method required)
# ============================================================================
# Get a key at https://aistudio.google.com/apikey - sign in, "Create API key".
# Model ids matter more than they look: Google retires a model for NEW keys
# before removing it for existing ones, so one that works on a colleague's
# account can 404 on a key you made this week. gemini-2.5-flash is exactly
# that case. The 404 names its replacement, and `python doctor.py` reads it
# out for you. Current list: https://ai.google.dev/gemini-api/docs/models
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash


# ============================================================================
# OPTION 2 - OPENROUTER (free models, one key for many providers)
# ============================================================================
# Get a key at https://openrouter.ai/keys
# OPENROUTER_MODEL has no default on purpose: free model ids rotate as
# providers add and drop promotions, so a baked-in guess would 404 on you.
# Pick a current one from https://openrouter.ai/models?max_price=0
# Free ids end in ':free'. Typical free-tier limit is ~20 req/min, 200/day.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=vendor/model-name:free


# ============================================================================
# OPTION 3 - OLLAMA (fully local, no key, no network, no cost)
# ============================================================================
# 1. Install from https://ollama.com/download
# 2. Pull a model:  ollama pull llama3.2
# 3. Set AI_PROVIDER=ollama above (Ollama is never auto-selected, because
#    having it installed is not the same as wanting the platform to use it)
# OLLAMA_MODEL must match a tag from `ollama list`.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2


# ============================================================================
# OPTION 4 - CLAUDE (paid; requires a payment method on the Anthropic account)
# ============================================================================
# Get a key at https://console.anthropic.com/
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-opus-5


# Which provider embeds, when it should not be the one that generates.
#
# Generation and embedding are separate capabilities and the obvious setup
# splits them: OpenRouter has free models with a generous daily allowance but
# publishes no embeddings endpoint, while Gemini's free generation quota is
# small and its embedding quota is not. So OPENROUTER_API_KEY + GEMINI_API_KEY
# with AI_PROVIDER=openrouter gets you both, and semantic search keeps working.
#
# Unset is usually right: the generation provider embeds when it can, and
# otherwise any other configured provider that can. Set this only to pin it.
# AI_EMBED_PROVIDER=gemini

# ============================================================================
# EVERYTHING ELSE
# ============================================================================
# "true" forces mock answers even when a key is present (useful for offline
# demos and for keeping a live key from being spent during development).
USE_MOCK_AI=false

# Database (SQLite by default, PostgreSQL for production)
# DATABASE_URL=postgresql://user:pass@localhost/mining_reports

# Backend URL (for Streamlit to connect to FastAPI)
BACKEND_URL=http://localhost:8000

# Accounts that may sign in, comma-separated as username:password:Display Name.
# There is no signup endpoint - this is the only way an account is created.
AUTH_USERS=

# Closing an account. Seeding only ever adds, so dropping a name from
# AUTH_USERS leaves that account working - list it here to delete it.
AUTH_REMOVE_USERS=

# Signs session tokens. No default: a key in source would let anyone mint a
# token for any user. Unset, one is generated per process, so a restart signs
# everyone out.
AUTH_SECRET=

# Full path to tesseract.exe, for a machine where OCR is installed but not on
# PATH. The Windows installer offers to add itself and the box is easy to
# miss, which leaves scanned PDFs silently extracting to nothing. The standard
# install locations are checked automatically, so this is only needed if yours
# is somewhere else. `python -m evaluation.inspect_documents samples/corpus`
# reports whether OCR is working, and where it found the binary.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Which languages OCR reads, as tesseract codes joined by "+". Each needs its
# traineddata installed; a code without it is dropped rather than failing the
# run. English first, because mixed CMPDI documents are the norm.
# OCR_LANGUAGES=eng+hin+tel
